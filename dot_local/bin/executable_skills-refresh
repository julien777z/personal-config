#!/usr/bin/env bash
# Refresh the canonical skills checkout without disturbing an editing branch.
set -euo pipefail
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

repo="$HOME/.local/share/agent-skills"
remote='https://github.com/julien777z/skills.git'

if [ ! -d "$repo/.git" ]; then
  if [ -e "$repo" ]; then
    echo "skills-refresh: $repo exists but is not a Git checkout" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$repo")"
  git clone "$remote" "$repo"
else
  if [ "$(git -C "$repo" remote get-url origin)" != "$remote" ]; then
    echo "skills-refresh: unexpected origin in $repo" >&2
    exit 1
  fi
  branch="$(git -C "$repo" branch --show-current)"
  if [ -z "$branch" ] || [ -n "$(git -C "$repo" status --porcelain)" ]; then
    echo "skills-refresh: checkout is detached or dirty; preserving local edits" >&2
    exit 1
  fi
  git -C "$repo" pull --ff-only origin "$branch"
fi

bash "$repo/bootstrap/install.sh"
